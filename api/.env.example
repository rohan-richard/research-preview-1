# Postgres. docker compose up -d starts one that matches this line.
DATABASE_URL=postgresql+psycopg://rumi:rumi@localhost:5432/rumi

# Signs our access tokens. Use a long random string: openssl rand -hex 32
JWT_SECRET=

# OAuth client IDs that may sign in. Comma-separated when there is more than one (web and iOS).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Web origins that may call the API with cookies, comma-separated. Leave empty to allow none.
CORS_ORIGINS=http://localhost:5173

# AIService chat server, base URL with its API prefix, and the rumi-chat tenant key.
CHAT_SERVER_URL=
CHAT_SERVER_API_KEY=

# Bucket for export files and patient uploads. AWS credentials come from the usual AWS_* variables or the instance role.
S3_BUCKET=
# With no bucket, files go to this folder and are served by the API at API_BASE_URL (local development).
LOCAL_FILES_DIR=var/files
API_BASE_URL=http://localhost:8000

# Web Push VAPID key pair (base64url) and the contact for the push services, for example mailto:ops@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# APNs auth key from the Apple developer account: the key ID, the team ID, the .p8 contents (\n for line breaks), and the app bundle ID.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# Send every APNs push to the sandbox host, for a dev server. Default false.
APNS_USE_SANDBOX=false

# Shared secret the chat server sends in X-Rumi-Webhook-Secret on POST /v1/integrations/chat-server/nudge.
CHAT_SERVER_WEBHOOK_SECRET=

# Fasten Connect: the public id (public_test_... or public_live_...) and the private key from the Fasten portal.
FASTEN_PUBLIC_ID=
FASTEN_PRIVATE_KEY=
# Signs the webhooks Fasten posts to /v1/integrations/fasten/webhook. Test and live keys have different secrets.
FASTEN_WEBHOOK_SECRET=
# Fasten API base URL. Leave the default unless Fasten gives you another one.
FASTEN_API_URL=https://api.connect.fastenhealth.com/v1
